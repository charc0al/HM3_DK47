{
	"name": "smf-mod",
	"version": "0.0.0",
	"description": "An SMF mod.",
	"license": "LGPL-3.0-only",
	"private": true,
	"devDependencies": {
		"@biomejs/biome": "1.9.4",
		"conventional-changelog-conventionalcommits": "^6.1.0",
		"husky": "^8.0.3",
		"lint-staged": "^13.2.3",
		"prettier": "3.0.0",
		"semantic-release-export-data": "^1.0.1",
		"fs-extra": "11.2.0",
		"json5": "2.2.3",
		"klaw-sync": "6.0.0",
		"ajv": "8.12.0"
	},
	"scripts": {
		"format:entities": "node ../../agentTools/HM3_D47/format_glacierkit_json.cjs",
		"test:entity-format": "node --test ../../agentTools/HM3_D47/format_glacierkit_json.test.cjs",
		"prepare": "husky install"
	},
	"lint-staged": {
		"**/*.entity{,.patch}.json": "node ../../agentTools/HM3_D47/format_glacierkit_json.cjs --write",
		"**/!(*.entity.json|*.entity.patch.json)": "prettier --write --ignore-unknown"
	}
}

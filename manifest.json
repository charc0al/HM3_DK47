  "options": [
    {
      "name": "Beer",
      "tooltip": "Adds Beer as a new item, available under Drinks at the loadout.",
      "group": "Drinks",
      "type": "checkbox",
      "enabledByDefault": true,
      "contentFolders": [
        "content/beer"
      ]
    },
    {
      "name": "Champagne",
      "tooltip": "Adds Champagne as a new item, available under Drinks at the loadout.",
      "group": "Drinks",
      "type": "checkbox",
      "enabledByDefault": true,
      "contentFolders": [
        "content/champagne"
      ]
    },
    {
      "name": "Glasses (See tooltip)",
      "tooltip": "(DUPLICATE OF DRINKS & LIQUIDS MOD ITEMS - DONT ENABLE THESE ON BOTH MODS) Adds Champagne and Whiskey glasses as a new items, available under Drinks at the loadout.",
      "group": "Drinks",
      "type": "checkbox",
      "enabledByDefault": false,
      "contentFolders": [
        "content/glasses"
      ]
    },
    {
      "name": "Unlockables",
      "tooltip": "Adds vodka and whiskey bottles to the loadout screen.",
      "group": "Drinks",
      "type": "checkbox",
      "enabledByDefault": true,
      "contentFolders": [
        "content/unlockables"
      ]
    },
    {
      "name": "Safehouse | Vodka",
      "tooltip": "Adds a drinkable vodka bottle to the Freelancer safehouse garage.",
      "group": "Safehouse",
      "type": "checkbox",
      "enabledByDefault": true,
      "contentFolders": [
        "content/safehouse_vodka"
      ]
    },
    {
      "name": "Safehouse | Whiskey",
      "tooltip": "Adds a drinkable whiskey bottle to the Freelancer safehouse.",
      "group": "Safehouse",
      "type": "checkbox",
      "enabledByDefault": true,
      "contentFolders": [
        "content/safehouse_whiskey"
      ]
    },
    {
      "name": "Safehouse | Champagne Glass",
      "tooltip": "Adds a champagne glass to the safehouse. Enable the Glasses option for this.",
      "group": "Safehouse",
      "type": "checkbox",
      "enabledByDefault": false,
      "contentFolders": [
        "content/safehouse_champagne_glass",
        "content/glasses"
      ]
    },
    {
      "name": "Safehouse | Whiskey Glass",
      "tooltip": "Adds a drinkable whiskey glass to the safehouse. Enable the Glasses option for this.",
      "group": "Safehouse",
      "type": "checkbox",
      "enabledByDefault": false,
      "contentFolders": [
        "content/safehouse_whiskey_glass",
        "content/glasses"
      ]
    }
  ],
